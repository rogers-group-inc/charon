# --- Secrets & local config (NEVER commit — repo is public) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
state/
.setup-complete
.update-status.json

# Internal-only build prompt (contains internal paths/app references)
CHARON_BUILD_PROMPT.md

# Audit output
audit/

# --- Node ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.npm/

# --- Prisma generated client ---
src/generated/

# --- Rust / Tauri agent ---
agent/target/
agent/**/target/
**/*.rs.bk

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# --- Claude Code ---
# Per-developer settings (permissions, hook config) and scratch worktrees are
# local; the project SKILLS under .claude/skills/ are tracked project memory and
# must NOT be ignored (git cannot re-include a child of an excluded directory,
# hence the `/*` + `!` pair).
.claude/*
!.claude/skills/

# Session-workflow lock files (a worktree in use / a dev stack running) — never committed
WORKLOCK
DEVLOCK
