{
  "name": "charon",
  "version": "0.1.0",
  "description": "Charon — Zero Trust Network Access (ZTNA) platform: identity + posture → dynamic FortiGate tags & policies",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate && (git config core.hooksPath .githooks || true)",
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "build": "tsc && node scripts/copy-build-assets.mjs",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx/esm prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "rules:next": "node scripts/next-rule-number.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/ws": "^8.18.2",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ldapts": "^9.2.0",
    "multer": "^2.5.0",
    "net-snmp": "^3.29.2",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.3.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
