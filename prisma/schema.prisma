// Prisma Schema — Charon (Zero Trust Network Access)
// Run: npx prisma migrate dev --name init
//
// Charon decides WHO + WHAT may reach network resources and enforces by
// pushing dynamic tags to Fortinet, where FortiGates apply dynamic firewall
// policies. This schema models: operators + RBAC (User/Role/GroupMapping),
// integrations + encrypted credentials, enrolled endpoints (the Tauri agent),
// the directory→tag pipeline (DirectoryObject/CustomGroup/Tag/TagSource), the
// enforcement writeback state (Policy/EndpointTag/EnforcementState), and the
// audit log (Event).
//
// SECURITY: secret values inside Integration.config / Credential.config are
// AES-256-GCM envelopes (see src/utils/crypto.ts), not plaintext. Agent bearer
// tokens are stored ONLY as a SHA-384 hash. The repo is public — no real data,
// hostnames, or secrets ever land in a migration or seed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Lifecycle of an enrolled endpoint agent.
enum EndpointStatus {
  pending // invitation issued, not yet enrolled
  enrolled // bearer issued, no telemetry connection yet
  online // telemetry WebSocket connected + heartbeating
  offline // enrolled but telemetry connection lost
  revoked // bearer revoked; agent locked out
}

/// Device posture compliance, computed by the worker posture evaluator.
enum PostureState {
  unknown
  compliant
  noncompliant
}

/// Server-dictated agent login mode (also the operator-auth mode). The agent
/// asks GET /api/v1/agent/auth-config and renders the matching flow.
enum AuthMode {
  local
  saml
  oidc
}

/// What a tag's membership is derived from.
enum TagSourceKind {
  directory_group // AD/Entra security group
  directory_ou // AD organizational unit
  custom_group // Charon-defined custom group
  posture // a posture state (e.g. compliant)
}

/// Where a directory object came from.
enum DirectoryObjectKind {
  user
  group
  ou
  device // a computer object (AD) or Entra / Intune device — deployment targets + device facts
}

/// Per-integration enforcement mode. dry_run (default) logs intended Fortinet
/// changes without writing; enforce applies them. Flipping to enforce against
/// production firewalls requires human review.
enum EnforcementMode {
  dry_run
  enforce
}

/// Desired-vs-actual sync state for a Fortinet object (address group / policy /
/// per-endpoint membership).
enum SyncStatus {
  pending // delta queued, not yet applied
  in_sync // actual matches desired
  drift // actual diverged from desired (surfaced on Integrations page)
  error // last apply attempt failed
  dry_run // intended change logged only (enforcement OFF)
}

// ─── Operators + RBAC ───────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?
  permissions Json     @default("{}") // function-key → access-level matrix (see permissions.ts)
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  isProtected Boolean  @default(false) @map("is_protected")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  groupMappings GroupMapping[]
  apiTokens     ApiToken[]

  @@map("roles")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  passwordHash String? @map("password_hash") // null for SSO-only operators
  roleId       String  @map("role_id")
  role         Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  authProvider String  @default("local") @map("auth_provider") // "local" | "saml" | "oidc" | "ldap"
  azureOid     String? @unique @map("azure_oid")
  oidcSubject  String? @unique @map("oidc_subject")
  ldapUid      String? @unique @map("ldap_uid")
  ssoGroups    String[] @default([]) @map("sso_groups")
  displayName  String? @map("display_name")
  email        String?
  lastLogin    DateTime? @map("last_login")

  // TOTP second factor — local accounts only.
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  totpBackupCodes String[]  @default([]) @map("totp_backup_codes")

  needsRoleReview Boolean @default(false) @map("needs_role_review")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}

/// Maps a normalized IdP/directory group key → a Charon Role for SSO-provisioned
/// operators. Highest-privilege match wins (see permissions.ts).
model GroupMapping {
  id        String   @id @default(uuid())
  groupKey  String   @map("group_key") // normalized directory group identifier
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupKey, roleId])
  @@index([groupKey])
  @@map("group_mappings")
}

// ─── Settings + integrations ─────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Integration {
  id              String    @id @default(uuid())
  type            String // "fortimanager" | "fortigate" | "activedirectory" | "entraid" (Intune = entraid config.enableIntune)
  name            String
  config          Json      @default("{}") // connection settings; secret fields are AES-256-GCM envelopes
  enabled         Boolean   @default(true)
  autoDiscover    Boolean   @default(true)
  pollInterval    Int       @default(4) // hours
  // Per-integration enforcement gate. dry_run (default) logs intended Fortinet
  // changes without writing — flipping to enforce requires human review.
  enforcementMode EnforcementMode @default(dry_run) @map("enforcement_mode")
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastDiscoveryAt DateTime?
  lastSyncAt      DateTime? @map("last_sync_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  directoryObjects DirectoryObject[]
  enforcementState EnforcementState[]

  @@index([type])
  @@index([enabled])
  @@map("integrations")
}

/// Live state of an integration's discovery run (ported from Polaris). One row
/// per integration: the web process enqueues it, the worker runs it and heartbeats
/// `workerHeartbeatAt`; the leader's reaper fails a run whose worker went silent.
/// The device counters are for the Fortinet types (FortiGates reached under a
/// FortiManager); a directory run reports its object counts in `completedCount`.
model DiscoveryRun {
  id                  String    @id @default(uuid())
  integrationId       String    @unique
  integrationName     String
  type                String // mirrors Integration.type
  status              String    @default("queued") // queued | running | completed | aborted | error
  actor               String // who triggered it (username or "auto-discovery")
  startedAt           DateTime? // set by the worker at run start
  updatedAt           DateTime  @updatedAt
  finishedAt          DateTime?
  totalDevices        Int?
  completedCount      Int       @default(0)
  skippedOfflineCount Int       @default(0)
  skippedErrorCount   Int       @default(0)
  activeDevices       Json      @default("[]") // [{ name, startedAt }]
  slowAlerted         Boolean   @default(false)
  slowAlertedDevices  Json      @default("[]") // string[] of device names already slow-alerted
  cancelRequested     Boolean   @default(false) // web sets this; the worker polls it and aborts
  workerHeartbeatAt   DateTime? // last write from the worker; drives the stale-run reaper
  scopeDeviceName     String? // set when the run is scoped to one FortiGate; NULL = full run
  createdAt           DateTime  @default(now())

  @@index([status])
  @@map("discovery_runs")
}

/// Trust-on-first-use pin of an SSH server's host key (ported from Polaris). Every
/// outbound SSH connection (credential probes, agent push install / upgrade /
/// uninstall) pins the first key seen for host:port and refuses a different key
/// BEFORE authenticating, unless its credential sets `verifyHostKey: false`.
/// Plain table, no Endpoint FK — a target is pinned before it has enrolled, and
/// the pin is keyed by the address actually dialed. Deleting a row re-opens
/// first-use trust for that host (the documented re-key recovery; audited).
model SshHostKey {
  id          String   @id @default(uuid())
  host        String
  port        Int      @default(22)
  keyType     String // "ssh-ed25519", "ecdsa-sha2-nistp256", "ssh-rsa", ...
  fingerprint String // "SHA256:<base64, unpadded>" — same form `ssh-keygen -lf` prints
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@unique([host, port])
  @@map("ssh_host_keys")
}

/// Trust-on-first-use pin of the TLS leaf certificate a server presented, for the
/// HTTPS connections that carry a secret WITHOUT verifying a CA chain (an
/// integration with verifySsl off, WinRM, credential probes). The first
/// connection to host:port pins the leaf SHA-256; a later connection presenting a
/// different certificate is refused BEFORE the request carrying the secret is
/// written. A CA-verified connection is not pinned.
model TlsCertPin {
  id                 String    @id @default(uuid())
  host               String
  port               Int
  fingerprint        String // leaf certificate SHA-256, colon-separated hex (Node's fingerprint256)
  subject            String    @default("") // the certificate's subject CN, for display
  firstSeen          DateTime  @default(now())
  lastSeen           DateTime  @default(now())
  /// The certificate presented INSTEAD of the pinned one, kept so an
  /// administrator can trust exactly that certificate ("Trust new certificate")
  /// rather than deleting the pin and trusting whatever answers next. Cleared
  /// when trusted, or when the pinned certificate comes back.
  pendingFingerprint String?   @map("pending_fingerprint")
  pendingSubject     String?   @map("pending_subject")
  pendingSeenAt      DateTime? @map("pending_seen_at")
  /// Until when the NEXT changed certificate is accepted and re-pinned without a
  /// person (`allowRepin`).
  repinUntil         DateTime? @map("repin_until")

  @@unique([host, port])
  @@map("tls_cert_pins")
}

model Credential {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String // "snmp" | "winrm" | "ssh" | "restapi" | "http" (Server Settings → Credentials)
  config    Json     @default("{}") // secret fields are AES-256-GCM envelopes
  // Ownership dimension for the `credentials` function key (ported from
  // polaris): write = edit/delete/test your own rows, fullwrite = any row. A
  // username, no FK; null = UNOWNED (fullwrite-only) — never backfilled.
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customWidgets ManufacturerCustomWidget[] @relation("ManufacturerCustomWidgetCredential")

  @@index([type])
  @@map("credentials")
}

// ─── Endpoint agents (the Tauri agent) ───────────────────────────────────────

/// One-time invitation code that bootstraps an agent enrollment. The plaintext
/// is shown once at issuance; only its SHA-384 hash is stored.
model InvitationCode {
  id         String    @id @default(uuid())
  label      String? // operator note ("Q3 laptop rollout")
  codeHash   String    @map("code_hash") // SHA-384 of the one-time code
  codePrefix String    @map("code_prefix") // first chars for UI display
  maxUses    Int       @default(1) @map("max_uses")
  useCount   Int       @default(0) @map("use_count")
  expiresAt  DateTime? @map("expires_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? @map("revoked_at")

  endpoints Endpoint[]

  @@index([codePrefix])
  @@map("invitation_codes")
}

/// An enrolled endpoint: the device + its agent enrollment, telemetry state,
/// posture, current user binding, IP/MAC, and effective tags. Mirrors polaris's
/// ManagedAgent security model (one-time-token→bearer swap, leaf-cert pin).
model Endpoint {
  id           String         @id @default(uuid())
  hostname     String?
  status       EndpointStatus @default(pending)

  osPlatform   String? @map("os_platform") // "windows" | "macos" | "linux"
  osVersion    String? @map("os_version")
  arch         String?
  agentVersion String? @map("agent_version")

  // Current network identity (updated by telemetry). These feed Fortinet
  // dynamic address-group membership.
  currentIp  String? @map("current_ip")
  currentMac String? @map("current_mac")

  // Current verified user binding {user ↔ device ↔ IP}. boundUserKey is the
  // directory identity (UPN / sub), set on a successful agent login.
  boundUserKey  String?   @map("bound_user_key")
  boundUserName String?   @map("bound_user_name")
  boundAt       DateTime? @map("bound_at")

  // Posture: raw telemetry blob + the evaluated state.
  posture      Json         @default("{}") // OS/patch, disk encryption, AV/EDR, firewall, ...
  postureState PostureState @default(unknown) @map("posture_state")
  postureAt    DateTime?    @map("posture_at")

  // Enrollment: invitation → one-time enrollment token → long-lived bearer.
  invitationCodeId String?         @map("invitation_code_id")
  invitationCode   InvitationCode? @relation(fields: [invitationCodeId], references: [id], onDelete: SetNull)

  // Long-lived per-agent bearer, stored ONLY as SHA-384. Wire format
  // `charon_<base64url>`. Bound at issuance; rotated on revoke+re-enroll.
  bearerHash      String?   @map("bearer_hash")
  bearerPrefix    String?   @map("bearer_prefix")
  bearerIssuedAt  DateTime? @map("bearer_issued_at")
  bearerRevokedAt DateTime? @map("bearer_revoked_at")

  // Server leaf-cert pin(s) the agent trusts (SHA-256 hex). canonical + staged
  // for dual-pin rotation (agents accept old+new during rollover).
  serverCertFingerprint  String?  @map("server_cert_fingerprint")
  additionalCertFingerprints String[] @default([]) @map("additional_cert_fingerprints")

  lastSeenAt       DateTime? @map("last_seen_at")
  lastSeenIp       String?   @map("last_seen_ip")
  wsConnectedAt    DateTime? @map("ws_connected_at")
  wsDisconnectedAt DateTime? @map("ws_disconnected_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags             EndpointTag[]
  enforcementState EnforcementState[]

  @@index([status])
  @@index([bearerPrefix])
  @@index([currentIp])
  @@index([boundUserKey])
  @@map("endpoints")
}

// ─── Directory → ZTNA tags ────────────────────────────────────────────────────

/// A user / group / OU discovered from AD / Entra / Intune. Persisted as a tag
/// source. Read-only mirror of directory state, refreshed by the worker sync.
model DirectoryObject {
  id            String              @id @default(uuid())
  integrationId String              @map("integration_id")
  integration   Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  kind          DirectoryObjectKind
  externalId    String              @map("external_id") // objectGUID / Entra object id
  name          String
  // For users: UPN/sam. For groups/OUs: distinguishedName / group id.
  identifier    String?
  attributes    Json                @default("{}") // raw directory attributes (for custom-group rules)
  parentOu      String?             @map("parent_ou")
  syncedAt      DateTime            @default(now()) @map("synced_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, kind, externalId])
  @@index([kind])
  @@index([identifier])
  @@map("directory_objects")
}

/// Net-new: an operator-defined group with explicit members and/or rules over
/// directory attributes. A tag source like a directory group.
model CustomGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // Explicit member identifiers (directory user keys), unioned with rule matches.
  members     String[] @default([])
  // Rule set over DirectoryObject.attributes, e.g.
  // { "all": [ { "attr": "department", "op": "eq", "value": "OT" } ] }.
  rules       Json     @default("{}")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources TagSource[]

  @@map("custom_groups")
}

/// A named ZTNA tag. Its membership is the union of its TagSources, combined
/// with device posture. The reconciler computes each endpoint's effective tag
/// set and the enforcer mirrors it into Fortinet as `charon-<tag>` objects.
model Tag {
  id          String   @id @default(uuid())
  name        String   @unique // ZTNA tag name (the `charon-` prefix is added at the Fortinet boundary)
  description String?
  color       String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources      TagSource[]
  endpointTags EndpointTag[]
  policies     Policy[]

  @@map("tags")
}

/// Maps a source ({directory group | OU | custom group | posture state}) → a Tag.
model TagSource {
  id            String        @id @default(uuid())
  tagId         String        @map("tag_id")
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  kind          TagSourceKind
  // For directory_group/ou: the DirectoryObject.externalId (or DN). For
  // custom_group: customGroupId. For posture: the PostureState value.
  ref           String
  customGroupId String?       @map("custom_group_id")
  customGroup   CustomGroup?  @relation(fields: [customGroupId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([tagId, kind, ref])
  @@index([kind, ref])
  @@map("tag_sources")
}

/// Effective tag membership for an endpoint, computed by the reconciler. The
/// row exists while the endpoint holds the tag; removed when it no longer does.
model EndpointTag {
  id         String   @id @default(uuid())
  endpointId String   @map("endpoint_id")
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // Why the endpoint has this tag (audit breadcrumb): list of contributing
  // source descriptions.
  reasons    Json     @default("[]")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([endpointId, tagId])
  @@index([tagId])
  @@map("endpoint_tags")
}

// ─── Fortinet enforcement writeback ──────────────────────────────────────────

/// A Charon-managed dynamic firewall policy. Always namespaced `charon-*` at the
/// Fortinet boundary so Charon never touches operator-authored policies.
model Policy {
  id          String   @id @default(uuid())
  name        String   @unique // Charon-side name; `charon-` prefix applied on push
  description String?
  tagId       String   @map("tag_id")
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // Policy intent: source/destination/service/action, kept abstract here and
  // rendered to FortiGate CMDB shape by the enforcement service.
  spec        Json     @default("{}")
  enabled     Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tagId])
  @@map("policies")
}

/// Desired-vs-actual sync record for a Charon-owned Fortinet object on a given
/// integration. Drives the drift surface on the Integrations page and the
/// enforcer's idempotent delta application. ownerScope is always "charon" — the
/// ownership invariant that keeps Charon from rewriting operator objects.
model EnforcementState {
  id            String      @id @default(uuid())
  integrationId String      @map("integration_id")
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // What kind of object: "addrgrp" | "address" | "policy".
  objectType    String      @map("object_type")
  // Charon-managed object name (always charon-*).
  objectName    String      @map("object_name")
  endpointId    String?     @map("endpoint_id")
  endpoint      Endpoint?   @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  desired       Json        @default("{}")
  actual        Json        @default("{}")
  status        SyncStatus  @default(pending)
  lastError     String?     @map("last_error")
  lastAppliedAt DateTime?   @map("last_applied_at")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, objectType, objectName])
  @@index([status])
  @@index([integrationId])
  @@map("enforcement_state")
}

// ─── Verification sessions (agent user login) ────────────────────────────────

/// A short-lived verification binding {user ↔ device ↔ IP} established when a
/// user authenticates through the agent login GUI. Drives tag reconciliation.
model VerificationSession {
  id         String    @id @default(uuid())
  endpointId String    @map("endpoint_id")
  userKey    String    @map("user_key") // directory identity (UPN/sub)
  userName   String?   @map("user_name")
  ip         String?
  mode       AuthMode
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([endpointId])
  @@index([userKey])
  @@map("verification_sessions")
}

// ─── API tokens + audit log ──────────────────────────────────────────────────

model ApiToken {
  id          String    @id @default(uuid())
  name        String    @unique
  tokenHash   String    @map("token_hash") // SHA-384 of the raw token
  tokenPrefix String    @map("token_prefix")
  scopes      String[]  @default([]) // legacy fixed-scope list; role binding supersedes it
  // Role whose permission matrix this token acts with (polaris port). Null only
  // for tokens minted before role binding existed — those reach nothing gated
  // by requirePermission. Restrict: a role referenced by a token can't be deleted.
  roleId      String?   @map("role_id")
  role        Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Source addresses (bare IPs / CIDRs, matched against req.ip) the token is
  // accepted from. Empty = any source.
  trustedHosts String[] @default([]) @map("trusted_hosts")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  revokedBy   String?

  @@index([roleId])
  @@index([tokenPrefix])
  @@index([revokedAt])
  @@map("api_tokens")
}

model Event {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  level        String   @default("info") // info, warning, error
  levelRank    Int      @default(0) // 0=info 1=warning 2=error
  action       String // e.g. "endpoint.enrolled", "tag.reconciled", "enforcement.applied"
  resourceType String?
  resourceId   String?
  resourceName String?
  actor        String?
  message      String   @db.Text
  details      Json?

  @@index([timestamp])
  @@index([action])
  @@index([resourceType])
  @@index([level])
  @@index([levelRank, timestamp])
  @@index([actor, timestamp])
  @@map("events")
}

// ─── Server Settings: Identification ───
// Ported from polaris (Tag / AssetTypeDef / DeviceIcon). Named Asset* because
// charon's own `Tag` is the ZTNA tag pushed to Fortinet — these are the
// asset/device classification registries behind the Identification tab.
// Charon has no asset inventory yet, so nothing references these rows; the
// registries are kept so charon Endpoints can be classified by them later.
// DNS / OUI / placeholder-MAC config lives in the Setting table (as polaris).

// Asset-tag registry. `assetCondition` is the auto-assign device filter (the
// shared condition-builder tree); NULL = an ordinary manual tag. An empty
// tree is collapsed to NULL on write — it is never "all devices".
model AssetTag {
  id             String   @id @default(uuid())
  name           String   @unique
  category       String   @default("General")
  // "#rrggbb" or "severity:<level>" — written only via normalizeTagColor.
  color          String   @default("#4fc3f7")
  assetCondition Json?    @map("asset_condition")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("asset_tags")
}

// Device-type registry (polaris AssetTypeDef). Built-ins are seeded by the
// migration with isBuiltIn + isProtected; their matching rules stay editable.
model AssetTypeDef {
  id            String   @id @default(uuid())
  name          String   @unique // lowercase [a-z0-9_-], 2-32 chars
  label         String
  description   String?
  isBuiltIn     Boolean  @default(false) @map("is_built_in")
  isProtected   Boolean  @default(false) @map("is_protected")
  createdBy     String?  @map("created_by")
  // Nested AND/OR tree validated by src/utils/assetTypeMatch.ts; null = never inferred.
  matchRules    Json?    @map("match_rules")
  matchContexts String[] @default([]) @map("match_contexts")
  matchPriority Int      @default(100) @map("match_priority")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("asset_type_defs")
}

// Operator-uploaded device icons (bytes in the DB, as polaris, so HA replicas
// serve the same images without a shared filesystem).
model DeviceIcon {
  id         String   @id @default(uuid())
  scope      String // "manufacturer-type" | "manufacturer-model"
  key        String // "<manufacturer>/<assetType|model>"
  filename   String
  mimeType   String   @map("mime_type")
  data       Bytes
  size       Int
  uploadedBy String?  @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@unique([scope, key])
  @@index([scope])
  @@map("device_icons")
}

// ─── Server Settings: API Tokens + High Availability ───

// One HA node enrollment (polaris port). The tab mints a single-use token
// embedded in a bootstrap script; the node registers with it (token spent),
// an operator approves, and the node downloads its bundle ONCE. Only SHA-384
// digests of the token and of the poll handle are stored.
model HaEnrollment {
  id       String @id @default(uuid())
  role     String // "primary" | "standby"
  nodeName String @map("node_name")
  nodeAddr String @map("node_addr")

  tokenHash     String   @map("token_hash") // SHA-384 of the raw token
  tokenPrefix   String   @map("token_prefix")
  expiresAt     DateTime @map("expires_at")
  requestIdHash String?  @unique @map("request_id_hash") // SHA-384 of the poll handle

  // issued | pending | approved | delivered | rejected | expired
  status String @default("issued")

  registeredFromIp       String?   @map("registered_from_ip")
  registeredNodeName     String?   @map("registered_node_name")
  sshHostKeyFingerprints String[]  @default([]) @map("ssh_host_key_fingerprints")
  registeredAt           DateTime? @map("registered_at")

  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  rejectedBy  String?   @map("rejected_by")
  rejectedAt  DateTime? @map("rejected_at")
  deliveredAt DateTime? @map("delivered_at")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tokenPrefix])
  @@index([status])
  @@map("ha_enrollments")
}

// ─── Server Settings: Repository (firmware) ───
// Ported from polaris (business rule 87). Bytes live on disk under
// FIRMWARE_DIR (data/firmware); rows carry identity and placement. The CHECKs
// and PARTIAL unique indexes Prisma cannot express live in migration
// 20261028000007_settings_firmware. No upgrade-run / schedule / group models:
// Charon has no Asset inventory and never flashes a device.

/// One uploaded `.out`, filed under a manufacturer › device type › model node.
/// Each PLATFORM under a node holds at most one `primary` and one `backup`.
model FirmwareImage {
  id           String   @id @default(uuid())
  manufacturer String
  assetType    String   @map("asset_type") // "switch" | "access_point" | "firewall" — CHECK in the migration
  model        String // tree placement only
  platform     String? // header token, e.g. S108FF / FP231K; null = filename-only parse, never offered
  versionMajor Int?     @map("version_major")
  versionMinor Int?     @map("version_minor")
  versionPatch Int?     @map("version_patch")
  build        Int?
  versionLabel String   @map("version_label") // "7.6.8 build1164", or "7 build1164" from a filename-only parse
  parsedFrom   String   @map("parsed_from") // "header" | "filename"
  role         String   @default("primary") // "primary" | "backup" ("swapping" only inside the make-primary transaction)
  filename     String // original upload name
  sizeBytes    Int      @map("size_bytes") // ≤ 300 MiB (FortiGate); ≤ 100 MiB switch / AP
  sha256       String   @unique
  storagePath  String   @map("storage_path") // relative to FIRMWARE_DIR: "<id>.out"
  notes        String?  @db.Text
  uploadedBy   String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([manufacturer, assetType, platform])
  @@index([manufacturer, assetType, model])
  @@map("firmware_images")
}

/// Which device-admin login applies at a manufacturer (assetType null), device
/// type (model null) or model scope; the most specific live one wins.
/// credentialId names a Credential LOOSELY (no relation / FK — Charon
/// adaptation): a deleted credential leaves a dangling id that reads as stale.
model FirmwareCredentialBinding {
  id           String   @id @default(uuid())
  manufacturer String
  assetType    String?  @map("asset_type") // null = manufacturer-wide
  model        String? // non-null only with assetType
  source       String   @default("credential") // "credential" | "integration-token" (firewall scopes only)
  credentialId String?  @map("credential_id")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([manufacturer, assetType, model])
  @@map("firmware_credential_bindings")
}

// ─── Server Settings: Credentials (MIB database + manufacturer profiles) ───
// Ported from polaris (Server Settings → Credentials). Charon has no Asset
// inventory, so the polaris per-asset columns/tables are left out: no
// MibFile.assetId pin, no AssetCustomWidgetEnable, and none of the deprecated
// `composition` columns. Hand-written SQL (incl. the override scope CHECK and
// the partial type-default unique index Prisma cannot express) lives in
// migration 20261028000006_settings_credentials. Credential.createdBy (the
// ownership column) is added by the same migration.

/// Manufacturer alias map: lowercased+trimmed `alias` → canonical spelling.
model ManufacturerAlias {
  id        String   @id @default(uuid())
  alias     String   @unique // lowercased + trimmed input string
  canonical String // canonical manufacturer name (as-typed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonical])
  @@map("manufacturer_aliases")
}

/// SNMP MIB module uploaded from the MIB Database card. Text inline (≤ 1 MiB),
/// validated by the SMI parser on upload. manufacturer null = generic.
model MibFile {
  id           String   @id @default(uuid())
  filename     String
  moduleName   String
  manufacturer String?
  model        String?
  contents     String   @db.Text
  imports      String[] @default([])
  size         Int
  notes        String?  @db.Text
  uploadedBy   String?
  uploadedAt   DateTime @default(now())

  profileMetricDefaults  ManufacturerProfileMetric[]         @relation("ManufacturerProfileMetricDefaultMib")
  profileMetricOverrides ManufacturerProfileMetricOverride[] @relation("ManufacturerProfileMetricOverrideMib")
  customWidgets          ManufacturerCustomWidget[]          @relation("ManufacturerCustomWidgetMib")

  @@unique([manufacturer, model, moduleName])
  @@index([manufacturer, model])
  @@index([moduleName])
  @@map("mib_files")
}

/// Operator-editable per-manufacturer SNMP telemetry profile.
model ManufacturerProfile {
  id           String   @id @default(uuid())
  manufacturer String   @unique // canonical form via ManufacturerAlias map
  matchPattern String? // "also applies when" regex (RE2 syntax)
  widgetLayout Json? // Custom MIB tab arrangement; null = default grid
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  metrics ManufacturerProfileMetric[]
  widgets ManufacturerCustomWidget[]

  @@map("manufacturer_profiles")
}

/// One row per System-tab metric a profile owns (METRIC_KEYS).
model ManufacturerProfileMetric {
  id                   String              @id @default(uuid())
  profileId            String
  profile              ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  metricKey            String
  defaultSymbol        String?
  defaultAggregate     String              @default("none") // "none" | "avg" | "sum"
  defaultLabel         String?
  defaultParsePattern  String?
  defaultParseTemplate String?
  defaultSensorColumns Json?
  defaultMibId         String?
  defaultMib           MibFile?            @relation("ManufacturerProfileMetricDefaultMib", fields: [defaultMibId], references: [id], onDelete: SetNull)
  defaultMibStdKey     String?
  defaultType          String              @default("scalar") // "scalar" | "double_scalar" | "table"
  defaultTransform     String?
  defaultSymbolB       String?

  overrides ManufacturerProfileMetricOverride[]

  @@unique([profileId, metricKey])
  @@index([defaultMibId])
  @@map("manufacturer_profile_metrics")
}

/// Scoped row under a metric: device-type default, per-model exception, or both.
model ManufacturerProfileMetricOverride {
  id            String                    @id @default(uuid())
  metricRowId   String
  metricRow     ManufacturerProfileMetric @relation(fields: [metricRowId], references: [id], onDelete: Cascade)
  assetType     String?
  modelPattern  String?
  symbol        String
  aggregate     String                    @default("none")
  label         String?
  parsePattern  String?
  parseTemplate String?
  sensorColumns Json?
  mibId         String?
  mib           MibFile?                  @relation("ManufacturerProfileMetricOverrideMib", fields: [mibId], references: [id], onDelete: SetNull)
  mibStdKey     String?
  type          String                    @default("scalar")
  transform     String?
  symbolB       String?
  order         Int                       @default(0)

  @@index([metricRowId, order])
  @@index([metricRowId, assetType])
  @@index([mibId])
  @@map("manufacturer_profile_metric_overrides")
}

/// Operator-defined custom widget (gauge / line / value / table / state / http).
model ManufacturerCustomWidget {
  id             String              @id @default(uuid())
  profileId      String
  profile        ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  symbol         String?
  mibId          String?
  mib            MibFile?            @relation("ManufacturerCustomWidgetMib", fields: [mibId], references: [id])
  type           String              @default("scalar")
  widgetType     String
  httpCheck      Json?
  credentialId   String?
  credential     Credential?         @relation("ManufacturerCustomWidgetCredential", fields: [credentialId], references: [id], onDelete: SetNull)
  transform      String?
  displayOptions Json                @default("{}")
  order          Int                 @default(0)
  modelPattern   String?
  stateMap       Json?
  labelSymbol    String?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([profileId, order])
  @@index([mibId])
  @@index([credentialId])
  @@map("manufacturer_custom_widgets")
}
